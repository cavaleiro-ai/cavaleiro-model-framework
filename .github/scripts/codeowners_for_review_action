# Specific files come after the sections/globs, so they take priority
/.circleci/config.yml @cavaleiro-ai
/utils/tests_fetcher.py @cavaleiro-ai
trainer.py @cavaleiro-ai
trainer_utils.py @cavaleiro-ai
/utils/modular_model_converter.py @cavaleiro-ai
/src/transformers/generation/continuous_batching/ @cavaleiro-ai
tests/generation/test_continuous_batching.py @cavaleiro-ai

